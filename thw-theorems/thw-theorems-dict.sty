\ProvidesPackage{thw-theorems-dict}
\RequirePackage{translations}

\newcommand{\@thwthm@crefname}[3]{
	\ifbool{@thwthm@cleveref}{%
		\AddToHook{begindocument}{%
			\crefname{#1}{#2}{#3}
		}%
	}{}
}

\newcommand{\DeclareCrefThmTranslation}[7]{
	\DeclareTranslation{English}{#1-cref}{#2}
	\DeclareTranslation{English}{#1-cref-plural}{#3}
	\DeclareTranslation{German}{#1-cref}{#4}
	\DeclareTranslation{German}{#1-cref-plural}{#5}
	\DeclareTranslation{French}{#1-cref}{#6}
	\DeclareTranslation{French}{#1-cref-plural}{#7}
	\@thwthm@crefname{#1}{\GetTranslation{#1-cref}}{\GetTranslation{#1-cref-plural}}
}

\newcommand{\DeclareThmTranslation}[7]{
	\DeclareTranslation{English}{#1}{#2}
	\DeclareTranslation{English}{#1-plural}{#3}
	\DeclareTranslation{German}{#1}{#4}
	\DeclareTranslation{German}{#1-plural}{#5}
	\DeclareTranslation{French}{#1}{#6}
	\DeclareTranslation{French}{#1-plural}{#7}
	\DeclareCrefThmTranslation{#1}{#2}{#3}{#4}{#5}{#6}{#7}
}

\newcommand{\DeclareEnGeFrTranslation}[4]{
	\DeclareTranslation{English}{#1}{#2}
	\DeclareTranslation{German}{#1}{#3}
	\DeclareTranslation{French}{#1}{#4}
}

